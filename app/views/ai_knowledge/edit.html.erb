<% html_title l(:label_ai_knowledge_edit) %>
<h2><%= link_to l(:label_ai_knowledge_base), ai_knowledge_path %> &#187; <%= l(:label_ai_knowledge_edit) %></h2>

<%= labelled_form_for @entry, as: :ai_knowledge_entry, url: ai_knowledge_entry_path(@entry), method: :patch do |f| %>
  <%= render partial: 'form', locals: { f: f } %>
  <%= submit_tag l(:button_save) %>
  <%= link_to l(:button_cancel), ai_knowledge_path %>
<% end %>
