<% html_title l(:label_ai_knowledge_new) %>
<h2><%= link_to l(:label_ai_knowledge_base), ai_knowledge_path %> &#187; <%= l(:label_ai_knowledge_new) %></h2>

<%= labelled_form_for @entry, as: :ai_knowledge_entry, url: ai_knowledge_path, method: :post do |f| %>
  <%= render partial: 'form', locals: { f: f } %>
  <%= submit_tag l(:button_create) %>
  <%= link_to l(:button_cancel), ai_knowledge_path %>
<% end %>
