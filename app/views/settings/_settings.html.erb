<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'ai_rewrite', plugin: 'redmine_ai_integration' %>
  <style>
    .provider-settings-section {
      border: 1px solid #ddd;
      border-radius: 6px;
      padding: 15px;
      margin: 15px 0;
      background: #f9f9f9;
    }
    
    .model-selection-group {
      display: flex;
      gap: 10px;
      align-items: center;
      margin-top: 5px;
    }
    
    .load-models-btn {
      background: #5ca9dd;
      color: white;
      border: 1px solid #4a8bc7;
      padding: 6px 14px;
      border-radius: 3px;
      cursor: pointer;
      font-size: 13px;
      transition: background-color 0.2s;
    }
    
    .load-models-btn:hover {
      background: #4a8bc7;
    }
    
    .load-models-btn:disabled {
      background: #ccc;
      border-color: #bbb;
      cursor: not-allowed;
    }
    
    .advanced-settings {
      margin-top: 25px;
      border-top: 1px solid #ddd;
      padding-top: 20px;
    }
    
    .advanced-settings-toggle {
      background: #f2f2f2;
      border: 1px solid #ccc;
      color: #333;
      cursor: pointer;
      font-size: 13px;
      padding: 6px 12px;
      border-radius: 3px;
      text-decoration: none;
    }
    
    .advanced-settings-toggle:hover {
      background: #e8e8e8;
    }
    
    .advanced-settings-content {
      display: none;
      margin-top: 15px;
    }
    
    .advanced-settings-content.show {
      display: block;
    }
    
    .toggle-switch {
      position: relative;
      display: inline-block;
      width: 50px;
      height: 24px;
    }
    
    .toggle-switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }
    
    .toggle-slider {
      position: absolute;
      cursor: pointer;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: #ccc;
      transition: .4s;
      border-radius: 24px;
    }
    
    .toggle-slider:before {
      position: absolute;
      content: "";
      height: 16px;
      width: 16px;
      left: 4px;
      bottom: 4px;
      background-color: white;
      transition: .4s;
      border-radius: 50%;
    }
    
    input:checked + .toggle-slider {
      background-color: #4a90e2;
    }
    
    input:checked + .toggle-slider:before {
      transform: translateX(26px);
    }
    
    .toggle-label {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 10px 0;
    }
    
    .ai-checkbox-row {
       margin: 15px 0 5px 0;
       padding-left: 180px; /* Reduced from 230px */
       display: flex;
       align-items: center;
       gap: 12px;
       font-size: 13px;
     }
    
    .ai-checkbox-row input[type="checkbox"] {
      margin: 0;
      width: 16px;
      height: 16px;
    }
    
    .ai-checkbox-row label, .ai-checkbox-row span {
      float: none !important;
      width: auto !important;
      margin: 0 !important;
      font-weight: normal;
      cursor: pointer;
    }

    .ai-checkbox-info {
      padding-left: 180px; /* Reduced from 230px */
      margin-top: 0;
      margin-bottom: 15px;
    }

    .prompt-header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 5px;
      padding-left: 180px; /* Reduced from 230px */
    }

    .prompt-header-row label {
      float: none !important;
      width: auto !important;
      margin: 0 !important;
      font-weight: bold;
    }

    .prompt-container {
      margin-bottom: 20px;
    }

    .prompt-container textarea {
      margin-left: 180px; /* Reduced from 230px */
      width: calc(100% - 180px) !important;
      box-sizing: border-box;
    }

    .prompt-container .info {
      display: block;
      margin-left: 180px; /* Reduced from 230px */
      margin-top: 5px;
    }

    .restore-defaults-btn {
      background: #f2f2f2;
      border: 1px solid #ccc;
      color: #666;
      padding: 2px 8px;
      border-radius: 3px;
      font-size: 11px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .restore-defaults-btn:hover {
      background: #e8e8e8;
      color: #333;
      border-color: #bbb;
    }
    
    .recommendation-info {
      margin-top: 10px;
      padding: 10px;
      background: #eef7fd;
      border: 1px solid #d0e8f8;
      border-radius: 4px;
      display: none;
    }
    
    .recommended-models-list {
      margin-top: 10px;
      display: none;
    }
    
    .pull-model-btn {
      background: #4caf50;
      color: white;
      border: 1px solid #388e3c;
      padding: 4px 10px;
      border-radius: 3px;
      font-size: 11px;
      cursor: pointer;
      margin-left: 10px;
    }
    
    .pull-model-btn:hover {
      background: #388e3c;
    }
    
    .pull-model-btn:disabled {
      background: #ccc;
      border-color: #bbb;
      cursor: wait;
    }

    .thinking-info {
      color: #666;
      font-style: italic;
      font-size: 11px;
      margin-left: 5px;
    }

    .billing-stats {
      margin-top: 20px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 15px;
    }

    .stat-card {
      background: white;
      border: 1px solid #ddd;
      border-radius: 6px;
      padding: 15px;
      text-align: center;
    }

    .stat-card h5 {
      margin: 0 0 10px 0;
      color: #666;
      font-size: 12px;
      text-transform: uppercase;
    }

    .stat-value {
      font-size: 20px;
      font-weight: bold;
      color: #2996cc;
    }

    .billing-log {
      margin-top: 20px;
      max-height: 400px;
      overflow-y: auto;
      border: 1px solid #ddd;
      border-radius: 4px;
    }

    .billing-table {
      width: 100%;
      border-collapse: collapse;
    }

    .billing-table th, .billing-table td {
      padding: 10px;
      text-align: left;
      border-bottom: 1px solid #eee;
    }

    .billing-table th {
      background: #f5f5f5;
      position: sticky;
      top: 0;
    }

    .billing-section {
      margin-top: 30px;
      border-top: 1px solid #ddd;
      padding-top: 20px;
    }

    .claude-oauth-block { margin-left: 0; }
    .claude-oauth-status { margin: 10px 0 8px 180px; }
    .claude-oauth-actions { margin-left: 180px; margin-bottom: 8px; }
    .claude-oauth-code-block { margin: 10px 0 10px 180px; padding: 10px; background: #fff; border: 1px dashed #bbb; border-radius: 4px; }
    .claude-oauth-hint { margin: 0 0 8px; font-size: 12px; color: #444; line-height: 1.6; }
    .claude-oauth-advanced { margin-left: 180px; margin-top: 6px; font-size: 12px; }
    .claude-oauth-advanced summary { cursor: pointer; color: #555; }
    .claude-oauth-badge { display: inline-block; padding: 2px 10px; border-radius: 10px; font-size: 11px; font-weight: bold; color: #fff; margin-right: 6px; }
    .claude-oauth-badge-ok { background: #3c9a3c; }
    .claude-oauth-badge-off { background: #999; }
    .task-models-section h4, .knowledge-section h4 { margin-top: 0; }

    .advanced-settings-content h4 {
      margin-left: 180px; /* Reduced from 230px */
    }
  </style>
<% end %>

<%= form_tag({ controller: 'settings', action: 'plugin', id: 'redmine_ai_integration' }, method: :post) do %>
  <div class="ai-integration-settings">
    <h3>AI Provider</h3>
    <p>
      <%= label_tag 'settings[ai_provider]', 'KI-Provider', style: 'float: left; width: 180px;' %>
      <%= select_tag 'settings[ai_provider]', 
          options_for_select([
            ['OpenAI (ChatGPT)', 'openai'],
            ['Google Gemini', 'gemini'],
            ['Anthropic Claude', 'claude'],
            ['Ollama (Lokal)', 'ollama']
          ], @settings['ai_provider'] || 'openai'),
          id: 'ai_provider_select' %>
      <em class="info">Wählen Sie den KI-Provider für Textverbesserung und Chat</em>
    </p>

    <div id="openai_settings" class="provider_settings provider-settings-section" style="<%= 'display:none;' unless @settings['ai_provider'] == 'openai' %>">
      <h4>OpenAI (ChatGPT)</h4>
      <p>
        <%= label_tag 'settings[openai_api_key]', 'OpenAI API Key', style: 'float: left; width: 180px;' %>
        <%= password_field_tag 'settings[openai_api_key]', @settings['openai_api_key'], size: 60 %>
        <em class="info">Ihr OpenAI API-Schlüssel</em>
      </p>
      <p>
        <%= label_tag 'settings[openai_model]', 'OpenAI Modell', style: 'float: left; width: 180px;' %>
        <div class="model-selection-group" style="margin-left: 180px;">
          <%= text_field_tag 'settings[openai_model]', @settings['openai_model'] || 'gpt-3.5-turbo', size: 40, id: 'openai_model_input' %>
          <button type="button" id="openai_load_models" class="load-models-btn">Modelle laden</button>
          <select id="openai_model_select" style="display:none;"></select>
        </div>
        <em class="info" style="margin-left: 180px; display: block; margin-top: 5px;">Verfügbare Modelle nach Klick auf "Modelle laden"</em>
      </p>
    </div>

    <div id="ollama_settings" class="provider_settings provider-settings-section" style="<%= 'display:none;' unless @settings['ai_provider'] == 'ollama' %>">
      <h4>Ollama (Lokal)</h4>
      <p>
        <%= label_tag 'settings[ollama_url]', 'Ollama URL', style: 'float: left; width: 180px;' %>
        <%= text_field_tag 'settings[ollama_url]', @settings['ollama_url'] || 'http://localhost:11434', size: 60 %>
        <em class="info">URL zu Ihrer Ollama-Instanz (z.B. http://localhost:11434)</em>
      </p>
      <p>
        <%= label_tag 'settings[ollama_model]', 'Ollama Modell', style: 'float: left; width: 180px;' %>
        <div class="model-selection-group" style="margin-left: 180px;">
          <%= text_field_tag 'settings[ollama_model]', @settings['ollama_model'] || 'llama2', size: 40, id: 'ollama_model_input' %>
          <button type="button" id="ollama_load_models" class="load-models-btn">Modelle laden</button>
          <button type="button" id="ollama_recommend_btn" class="load-models-btn" style="background-color: #2996cc; border-color: #2482b3;">Use Recommended Model</button>
          <select id="ollama_model_select" style="display:none;"></select>
        </div>
        <em class="info" style="margin-left: 180px; display: block; margin-top: 5px;">Verfügbare Modelle nach Klick auf "Modelle laden"</em>
      </p>
      
      <div id="ollama_recommendation_info" class="recommendation-info" style="margin-left: 180px;"></div>
      <div id="ollama_recommended_models" class="recommended-models-list" style="margin-left: 180px;">
        <strong>Empfohlene Modelle (nicht gefunden):</strong>
        <ul id="recommended_models_ul" style="margin-top: 10px; margin-left: 20px;">
          <li>glm4 <button type="button" class="pull-model-btn" onclick="pullOllamaModel('glm4')">ollama pull glm4</button></li>
          <li>gemma2 <button type="button" class="pull-model-btn" onclick="pullOllamaModel('gemma2')">ollama pull gemma2</button></li>
          <li>qwen2.5 <span class="thinking-info">(Thinking/Reasoning Modell)</span> <button type="button" class="pull-model-btn" onclick="pullOllamaModel('qwen2.5')">ollama pull qwen2.5</button></li>
          <li>mistral <button type="button" class="pull-model-btn" onclick="pullOllamaModel('mistral')">ollama pull mistral</button></li>
        </ul>
      </div>
      
      <div class="ai-checkbox-row" style="padding-left: 180px;">
        <%= check_box_tag 'settings[ollama_streaming]', '1', @settings['ollama_streaming'] == '1', id: 'ollama_streaming_toggle' %>
        <span onclick="document.getElementById('ollama_streaming_toggle').click()" style="cursor:pointer;">Streaming Response aktivieren</span>
      </div>
    </div>

    <div id="gemini_settings" class="provider_settings provider-settings-section" style="<%= 'display:none;' unless @settings['ai_provider'] == 'gemini' %>">
      <h4>Google Gemini</h4>
      <p>
        <%= label_tag 'settings[gemini_api_key]', 'Gemini API Key', style: 'float: left; width: 180px;' %>
        <%= password_field_tag 'settings[gemini_api_key]', @settings['gemini_api_key'], size: 60 %>
        <em class="info">Ihr Google Gemini API-Schlüssel</em>
      </p>
      <p>
        <%= label_tag 'settings[gemini_model]', 'Gemini Modell', style: 'float: left; width: 180px;' %>
        <div class="model-selection-group" style="margin-left: 180px;">
          <%= text_field_tag 'settings[gemini_model]', @settings['gemini_model'] || 'gemini-pro', size: 40, id: 'gemini_model_input' %>
          <button type="button" id="gemini_load_models" class="load-models-btn">Modelle laden</button>
          <select id="gemini_model_select" style="display:none;"></select>
        </div>
        <em class="info" style="margin-left: 180px; display: block; margin-top: 5px;">Verfügbare Modelle nach Klick auf "Modelle laden"</em>
      </p>
    </div>

    <div id="claude_settings" class="provider_settings provider-settings-section" style="<%= 'display:none;' unless @settings['ai_provider'] == 'claude' %>">
      <% oauth_status = RedmineAiIntegration::ClaudeOauth.status %>
      <h4>Anthropic Claude</h4>
      <p>
        <%= label_tag 'settings[claude_auth_mode]', 'Anmeldung', style: 'float: left; width: 180px;' %>
        <%= select_tag 'settings[claude_auth_mode]',
            options_for_select([
              ['API-Key (Console)', 'api_key'],
              ['Mit Claude-Konto anmelden (OAuth)', 'oauth']
            ], @settings['claude_auth_mode'] || 'api_key'),
            id: 'claude_auth_mode_select' %>
        <em class="info">API-Key aus der Claude Console oder Anmeldung mit einem Claude-Konto (z. B. Pro/Max/Team) ohne eigenen Schlüssel</em>
      </p>

      <div id="claude_api_key_block" style="<%= 'display:none;' if @settings['claude_auth_mode'] == 'oauth' %>">
        <p>
          <%= label_tag 'settings[claude_api_key]', 'Claude API Key', style: 'float: left; width: 180px;' %>
          <%= password_field_tag 'settings[claude_api_key]', @settings['claude_api_key'], size: 60 %>
          <em class="info">Ihr Anthropic Claude API-Schlüssel (platform.claude.com → API keys)</em>
        </p>
      </div>

      <div id="claude_oauth_block" class="claude-oauth-block" style="<%= 'display:none;' unless @settings['claude_auth_mode'] == 'oauth' %>">
        <p>
          <%= label_tag 'settings[claude_oauth_account_type]', 'Kontotyp', style: 'float: left; width: 180px;' %>
          <%= select_tag 'settings[claude_oauth_account_type]',
              options_for_select([
                ['Claude.ai-Konto (claude.ai)', 'claude'],
                ['Console-/Entwicklerkonto (console.anthropic.com)', 'console']
              ], @settings['claude_oauth_account_type'] || 'claude') %>
          <em class="info">Bestimmt, über welche Anmeldeseite der Login läuft</em>
        </p>
        <p>
          <%= label_tag 'settings[claude_oauth_redirect_mode]', 'Rückweg', style: 'float: left; width: 180px;' %>
          <%= select_tag 'settings[claude_oauth_redirect_mode]',
              options_for_select([
                ['Code manuell einfügen (empfohlen)', 'manual'],
                ['Automatische Weiterleitung zu Redmine', 'callback']
              ], @settings['claude_oauth_redirect_mode'] || 'manual') %>
          <em class="info">Die automatische Weiterleitung funktioniert nur, wenn die Redmine-Callback-URL für die Client-ID freigegeben ist</em>
        </p>

        <div class="claude-oauth-status" id="claude_oauth_status" data-logged-in="<%= oauth_status[:logged_in] ? '1' : '0' %>">
          <% if oauth_status[:logged_in] %>
            <span class="claude-oauth-badge claude-oauth-badge-ok">Verbunden</span>
            <span id="claude_oauth_account_label"><%= oauth_status[:account].presence || 'Claude-Konto' %></span>
            <% if oauth_status[:expires_at] %>
              <em class="info" style="display:inline; margin-left: 8px;">Token gültig bis <%= format_time(Time.parse(oauth_status[:expires_at])) %> (wird automatisch erneuert)</em>
            <% end %>
          <% else %>
            <span class="claude-oauth-badge claude-oauth-badge-off">Nicht verbunden</span>
          <% end %>
        </div>

        <div class="claude-oauth-actions">
          <button type="button" id="claude_oauth_login_btn" class="load-models-btn">Mit Claude anmelden</button>
          <button type="button" id="claude_oauth_logout_btn" class="load-models-btn" style="background:#c9534f; border-color:#b3443f; <%= 'display:none;' unless oauth_status[:logged_in] %>">Abmelden</button>
          <span id="claude_oauth_message" style="margin-left: 10px;"></span>
        </div>

        <div id="claude_oauth_code_block" class="claude-oauth-code-block" style="display:none;">
          <p class="claude-oauth-hint">
            1. Es wurde ein neues Browser-Fenster geöffnet (falls nicht: <a href="#" id="claude_oauth_open_link" target="_blank" rel="noopener">hier klicken</a>).<br>
            2. Melden Sie sich dort mit Ihrem Claude-Konto an und bestätigen Sie den Zugriff.<br>
            3. Kopieren Sie den angezeigten Code und fügen Sie ihn hier ein:
          </p>
          <div class="model-selection-group">
            <input type="text" id="claude_oauth_code_input" size="70" placeholder="Code aus dem Anmeldefenster einfügen (Format: code#state)" autocomplete="off">
            <button type="button" id="claude_oauth_exchange_btn" class="load-models-btn">Code einlösen</button>
          </div>
        </div>

        <details class="claude-oauth-advanced">
          <summary>Erweitert: eigene OAuth-Client-ID</summary>
          <p>
            <%= label_tag 'settings[claude_oauth_client_id]', 'Client-ID', style: 'float: left; width: 180px;' %>
            <%= text_field_tag 'settings[claude_oauth_client_id]', @settings['claude_oauth_client_id'], size: 50, placeholder: RedmineAiIntegration::ClaudeOauth::DEFAULT_CLIENT_ID %>
            <em class="info">Leer lassen für den Standard-Client</em>
          </p>
          <p>
            <%= label_tag 'settings[claude_oauth_scopes]', 'Scopes', style: 'float: left; width: 180px;' %>
            <%= text_field_tag 'settings[claude_oauth_scopes]', @settings['claude_oauth_scopes'], size: 50, placeholder: RedmineAiIntegration::ClaudeOauth::DEFAULT_SCOPES %>
          </p>
        </details>
        <em class="info" style="display:block; margin-top: 8px;">
          Hinweis: Die Anmeldung mit einem Claude-Abo-Konto unterliegt den Nutzungsbedingungen von Anthropic. Für Produktivbetrieb empfiehlt Anthropic einen API-Key bzw. ein Console-Konto.
        </em>
      </div>

      <p>
        <%= label_tag 'settings[claude_model]', 'Claude Standardmodell', style: 'float: left; width: 180px;' %>
        <div class="model-selection-group" style="margin-left: 180px;">
          <%= text_field_tag 'settings[claude_model]', @settings['claude_model'] || 'claude-opus-5-5', size: 40, id: 'claude_model_input' %>
          <button type="button" id="claude_load_models" class="load-models-btn">Modelle laden</button>
          <select id="claude_model_select" style="display:none;"></select>
        </div>
        <em class="info" style="margin-left: 180px; display: block; margin-top: 5px;">Verfügbare Modelle nach Klick auf "Modelle laden". Empfohlen: claude-opus-5-5 (Standard), claude-sonnet-5-5 (schneller/günstiger), claude-haiku-5-5 (sehr günstig)</em>
      </p>
    </div>

    <div class="provider-settings-section task-models-section">
      <h4>Modell pro Aufgabe</h4>
      <em class="info" style="display:block; margin-bottom: 10px;">
        Optional: eigenes Modell des gewählten Providers je Aufgabe. Leer = Standardmodell des Providers.
        So kann z. B. die Korrektur mit einem schnellen Modell laufen, während Chat und Lernen ein stärkeres Modell nutzen.
      </em>
      <% [
        ['model_correction', 'Korrektur', 'Button „Korrektur“ an Textfeldern'],
        ['model_complex',    'Erweitern', 'Button „Erweitern“ mit eigener Anweisung'],
        ['model_chat',       'KI-Assistent (Chat)', 'Chat in der Ticket-Sidebar'],
        ['model_learning',   'Wissens-Extraktion', 'Lernen aus Nutzer-Korrekturen für die Wissensbasis']
      ].each do |key, label, hint| %>
        <p>
          <%= label_tag "settings[#{key}]", label, style: 'float: left; width: 180px;' %>
          <div class="model-selection-group" style="margin-left: 180px;">
            <%= text_field_tag "settings[#{key}]", @settings[key], size: 40, id: "#{key}_input", placeholder: 'Standardmodell des Providers' %>
            <button type="button" class="load-models-btn task-model-load" data-target="<%= key %>">Modelle laden</button>
            <select id="<%= key %>_select" style="display:none;"></select>
          </div>
          <em class="info" style="margin-left: 180px; display: block; margin-top: 3px;"><%= hint %></em>
        </p>
      <% end %>
    </div>

    <div class="provider-settings-section knowledge-section">
      <% kb_stats = AiKnowledgeEntry.stats rescue { total: 0, active: 0, learned: 0, unreviewed: 0 } %>
      <h4>Wissensbasis (lernt aus Korrekturen)</h4>
      <em class="info" style="display:block; margin-bottom: 10px;">
        Die Wissensbasis enthält Regeln, Fachbegriffe und Stilvorgaben, die das Modell zusätzlich zum System-Prompt berücksichtigt.
        Ändert ein Nutzer eine KI-Korrektur nachträglich, wird daraus gelernt: Das Modell vergleicht seinen Vorschlag mit der finalen Fassung
        und legt verallgemeinerbare Erkenntnisse ab, damit derselbe Fehler nicht wieder passiert.
      </em>
      <div class="ai-checkbox-row" style="padding-left: 180px;">
        <%= hidden_field_tag 'settings[knowledge_base_enabled]', '0', id: nil %>
        <%= check_box_tag 'settings[knowledge_base_enabled]', '1', @settings['knowledge_base_enabled'] != '0', id: 'knowledge_base_enabled_toggle' %>
        <span onclick="document.getElementById('knowledge_base_enabled_toggle').click()" style="cursor:pointer;">Wissensbasis in Prompts einbinden</span>
      </div>
      <div class="ai-checkbox-row" style="padding-left: 180px;">
        <%= hidden_field_tag 'settings[knowledge_auto_learn]', '0', id: nil %>
        <%= check_box_tag 'settings[knowledge_auto_learn]', '1', @settings['knowledge_auto_learn'] == '1', id: 'knowledge_auto_learn_toggle' %>
        <span onclick="document.getElementById('knowledge_auto_learn_toggle').click()" style="cursor:pointer;">Automatisch lernen, wenn Nutzer eine KI-Korrektur vor dem Speichern verändern</span>
      </div>
      <p>
        <%= label_tag 'settings[knowledge_max_entries]', 'Max. Einträge im Prompt', style: 'float: left; width: 180px;' %>
        <%= number_field_tag 'settings[knowledge_max_entries]', @settings['knowledge_max_entries'] || '40', min: 1, max: 500, size: 6 %>
        <em class="info">Begrenzt Token-Verbrauch; projektspezifische und häufig bestätigte Einträge werden bevorzugt</em>
      </p>
      <p style="margin-left: 180px;">
        <strong><%= kb_stats[:active] %></strong> aktive Einträge (<%= kb_stats[:learned] %> gelernt, <%= kb_stats[:unreviewed] %> ungeprüft) –
        <%= link_to 'Wissensbasis verwalten', ai_knowledge_path, class: 'icon icon-book' %>
      </p>
    </div>

    <div class="advanced-settings">
      <button type="button" class="advanced-settings-toggle" onclick="toggleAdvancedSettings()">
        Erweiterte Einstellungen anzeigen
      </button>
      
      <div class="advanced-settings-content" id="advanced_settings_content">
        <h4>System-Prompts</h4>
        <div class="prompt-container">
          <div class="prompt-header-row">
            <%= label_tag 'settings[embedded_system_prompt]', 'Eingebetteter System-Prompt (Lektor & Korrektor)' %>
            <button type="button" class="restore-defaults-btn" id="restore_embedded_default">Standard wiederherstellen</button>
          </div>
          <%= text_area_tag 'settings[embedded_system_prompt]', @settings['embedded_system_prompt'], rows: 12, cols: 80, style: 'width: 100%;', id: 'settings_embedded_system_prompt' %>
          <em class="info">Dieser Prompt wird für die Funktionen "Korrektur" und "Erweitern" verwendet.</em>
        </div>

        <div class="prompt-container" style="margin-top: 20px;">
          <div class="prompt-header-row">
            <%= label_tag 'settings[chat_system_prompt]', 'KI-Assistent System-Prompt' %>
            <button type="button" class="restore-defaults-btn" id="restore_chat_default">Standard wiederherstellen</button>
          </div>
          <%= text_area_tag 'settings[chat_system_prompt]', @settings['chat_system_prompt'], rows: 6, cols: 80, style: 'width: 100%;', id: 'settings_chat_system_prompt' %>
          <em class="info">Dieser Prompt definiert das Verhalten des KI-Assistenten in der Sidebar.</em>
        </div>
      </div>
    </div>

    <div class="billing-section">
      <h3>Billing & Token Nutzung</h3>
      
      <%
        chat_stats_day = AiChatMessage.token_stats(:daily)
        chat_stats_week = AiChatMessage.token_stats(:weekly)
        chat_stats_month = AiChatMessage.token_stats(:monthly)
        
        rewrite_stats_day = AiTextVersion.token_stats(:daily)
        rewrite_stats_week = AiTextVersion.token_stats(:weekly)
        rewrite_stats_month = AiTextVersion.token_stats(:monthly)
        
        total_day = chat_stats_day[:total] + rewrite_stats_day[:total]
        total_week = chat_stats_week[:total] + rewrite_stats_week[:total]
        total_month = chat_stats_month[:total] + rewrite_stats_month[:total]
      %>
      
      <div class="billing-stats">
        <div class="stat-card">
          <h5>Heute</h5>
          <div class="stat-value"><%= number_with_delimiter(total_day) %></div>
          <em class="info">Tokens gesamt</em>
        </div>
        <div class="stat-card">
          <h5>Diese Woche</h5>
          <div class="stat-value"><%= number_with_delimiter(total_week) %></div>
          <em class="info">Tokens gesamt</em>
        </div>
        <div class="stat-card">
          <h5>Diesen Monat</h5>
          <div class="stat-value"><%= number_with_delimiter(total_month) %></div>
          <em class="info">Tokens gesamt</em>
        </div>
      </div>

      <h4>Letzte Aktivitäten</h4>
      <div class="billing-log">
        <table class="billing-table">
          <thead>
            <tr>
              <th>Zeitpunkt</th>
              <th>Typ</th>
              <th>Provider</th>
              <th>Input Tokens</th>
              <th>Output Tokens</th>
              <th>Gesamt</th>
            </tr>
          </thead>
          <tbody>
            <% 
              recent_chat = AiChatMessage.recent.limit(25).map { |m| { time: m.created_at, type: 'Chat', provider: m.provider, in: m.prompt_tokens, out: m.completion_tokens, total: m.total_tokens } }
              recent_rewrite = AiTextVersion.where("version_id NOT LIKE '%_original'").recent.limit(25).map { |v| { time: v.created_at, type: 'Rewrite', provider: v.provider, in: v.prompt_tokens, out: v.completion_tokens, total: v.total_tokens } }
              
              all_recent = (recent_chat + recent_rewrite).sort_by { |a| a[:time] }.reverse.first(50)
            %>
            <% all_recent.each do |log| %>
              <tr>
                <td><%= format_time(log[:time]) %></td>
                <td><%= log[:type] %></td>
                <td><%= log[:provider] || 'unbekannt' %></td>
                <td><%= number_with_delimiter(log[:in]) %></td>
                <td><%= number_with_delimiter(log[:out]) %></td>
                <td><strong><%= number_with_delimiter(log[:total]) %></strong></td>
              </tr>
            <% end %>
            <% if all_recent.empty? %>
              <tr>
                <td colspan="6" style="text-align: center;">Noch keine Aktivitäten aufgezeichnet.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <h3>Verbindung testen</h3>
    <p>
      <button type="button" id="test_connection_btn" class="button">Verbindung testen</button>
      <span id="test_connection_status" style="margin-left: 10px;"></span>
    </p>
    <div id="test_connection_result" style="margin-top: 10px; display: none;">
      <div id="test_connection_message"></div>
      <div id="test_connection_models" style="margin-top: 10px;"></div>
    </div>
  </div>

  <%= submit_tag l(:button_save) %>
<% end %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const providerSelect = document.getElementById('ai_provider_select');
    const providerSettings = document.querySelectorAll('.provider_settings');
    
    // Provider-Umschaltung
    providerSelect.addEventListener('change', function() {
      providerSettings.forEach(function(div) {
        div.style.display = 'none';
      });
      
      const selectedProvider = this.value;
      const selectedDiv = document.getElementById(selectedProvider + '_settings');
      if (selectedDiv) {
        selectedDiv.style.display = 'block';
      }
    });

    // Claude: Umschaltung API-Key / OAuth
    const authModeSelect = document.getElementById('claude_auth_mode_select');
    if (authModeSelect) {
      const apiBlock = document.getElementById('claude_api_key_block');
      const oauthBlock = document.getElementById('claude_oauth_block');
      authModeSelect.addEventListener('change', function() {
        const oauth = this.value === 'oauth';
        apiBlock.style.display = oauth ? 'none' : 'block';
        oauthBlock.style.display = oauth ? 'block' : 'none';
      });
    }

    // Claude OAuth-Anmeldung
    const oauthLoginBtn = document.getElementById('claude_oauth_login_btn');
    const oauthLogoutBtn = document.getElementById('claude_oauth_logout_btn');
    const oauthExchangeBtn = document.getElementById('claude_oauth_exchange_btn');
    const oauthMessage = document.getElementById('claude_oauth_message');
    const oauthCodeBlock = document.getElementById('claude_oauth_code_block');

    function oauthSay(text, color) {
      if (!oauthMessage) return;
      oauthMessage.textContent = text;
      oauthMessage.style.color = color || '#666';
    }

    function oauthPost(url, body) {
      return fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
        },
        body: JSON.stringify(body || {})
      }).then(r => r.json());
    }

    function oauthRenderStatus(status) {
      const box = document.getElementById('claude_oauth_status');
      if (!box) return;
      if (status.logged_in) {
        box.innerHTML = '<span class="claude-oauth-badge claude-oauth-badge-ok">Verbunden</span> <span>' +
          (status.account || 'Claude-Konto') + '</span>' +
          (status.expires_at ? ' <em class="info" style="display:inline; margin-left:8px;">Token gültig bis ' + new Date(status.expires_at).toLocaleString() + ' (wird automatisch erneuert)</em>' : '');
        box.dataset.loggedIn = '1';
        if (oauthLogoutBtn) oauthLogoutBtn.style.display = 'inline-block';
      } else {
        box.innerHTML = '<span class="claude-oauth-badge claude-oauth-badge-off">Nicht verbunden</span>';
        box.dataset.loggedIn = '0';
        if (oauthLogoutBtn) oauthLogoutBtn.style.display = 'none';
      }
    }

    if (oauthLoginBtn) {
      oauthLoginBtn.addEventListener('click', function() {
        oauthLoginBtn.disabled = true;
        oauthSay('Anmeldung wird vorbereitet...');
        // Die aktuell gewählten (evtl. ungespeicherten) OAuth-Optionen mitgeben
        oauthPost('/ai_auth/claude/start', {})
          .then(data => {
            oauthLoginBtn.disabled = false;
            if (!data.success) { oauthSay('Fehler: ' + data.error, 'red'); return; }
            const popup = window.open(data.authorize_url, '_blank', 'noopener');
            const link = document.getElementById('claude_oauth_open_link');
            if (link) link.href = data.authorize_url;
            if (data.redirect_mode === 'callback') {
              oauthSay('Nach der Anmeldung werden Sie automatisch zurück zu Redmine geleitet.', '#666');
            } else {
              oauthCodeBlock.style.display = 'block';
              document.getElementById('claude_oauth_code_input').focus();
              oauthSay(popup ? 'Anmeldefenster geöffnet.' : 'Popup blockiert – bitte Link im Hinweis nutzen.', popup ? '#666' : 'orange');
            }
          })
          .catch(err => { oauthLoginBtn.disabled = false; oauthSay('Fehler: ' + err.message, 'red'); });
      });
    }

    if (oauthExchangeBtn) {
      oauthExchangeBtn.addEventListener('click', function() {
        const code = document.getElementById('claude_oauth_code_input').value.trim();
        if (!code) { oauthSay('Bitte zuerst den Code einfügen.', 'orange'); return; }
        oauthExchangeBtn.disabled = true;
        oauthSay('Code wird eingelöst...');
        oauthPost('/ai_auth/claude/exchange', { code: code })
          .then(data => {
            oauthExchangeBtn.disabled = false;
            if (!data.success) { oauthSay('Fehler: ' + data.error, 'red'); return; }
            oauthCodeBlock.style.display = 'none';
            document.getElementById('claude_oauth_code_input').value = '';
            oauthRenderStatus(data.status);
            oauthSay('Claude-Konto verbunden. Vergessen Sie nicht, die Einstellungen zu speichern.', 'green');
          })
          .catch(err => { oauthExchangeBtn.disabled = false; oauthSay('Fehler: ' + err.message, 'red'); });
      });
    }

    if (oauthLogoutBtn) {
      oauthLogoutBtn.addEventListener('click', function() {
        if (!confirm('Claude-Konto wirklich trennen?')) return;
        oauthPost('/ai_auth/claude/logout', {})
          .then(data => {
            if (data.success) { oauthRenderStatus(data.status); oauthSay('Abgemeldet.', '#666'); }
            else oauthSay('Fehler: ' + data.error, 'red');
          });
      });
    }

    // Modell pro Aufgabe: Modelle des aktuell gewählten Providers laden
    document.querySelectorAll('.task-model-load').forEach(function(button) {
      button.addEventListener('click', function() {
        const key = button.dataset.target;
        loadModelsInto(providerSelect.value, button,
          document.getElementById(key + '_input'),
          document.getElementById(key + '_select'));
      });
    });

    // Modelle laden Buttons
    const loadModelButtons = {
      openai: document.getElementById('openai_load_models'),
      ollama: document.getElementById('ollama_load_models'),
      gemini: document.getElementById('gemini_load_models'),
      claude: document.getElementById('claude_load_models')
    };

    Object.entries(loadModelButtons).forEach(([provider, button]) => {
      if (button) {
        button.addEventListener('click', function() {
          loadModelsForProvider(provider);
        });
      }
    });

    // Test Connection Button
    const testBtn = document.getElementById('test_connection_btn');
    const statusSpan = document.getElementById('test_connection_status');
    const resultDiv = document.getElementById('test_connection_result');
    const messageDiv = document.getElementById('test_connection_message');
    const modelsDiv = document.getElementById('test_connection_models');

    testBtn.addEventListener('click', function() {
      const provider = providerSelect.value;
      testBtn.disabled = true;
      statusSpan.textContent = 'Teste Verbindung...';
      statusSpan.style.color = '#666';
      resultDiv.style.display = 'none';

      fetch('/ai_rewrite/test_connection', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
        },
        body: JSON.stringify({ provider: provider })
      })
      .then(response => response.json())
      .then(data => {
        testBtn.disabled = false;
        resultDiv.style.display = 'block';

        if (data.success) {
          statusSpan.textContent = 'Erfolgreich';
          statusSpan.style.color = 'green';
          messageDiv.innerHTML = '<strong style="color: green;">' + (data.message || 'Verbindung erfolgreich') + '</strong>';
          
          if (data.models && data.models.length > 0) {
            modelsDiv.innerHTML = '<strong>Verfügbare Modelle:</strong><ul style="margin-top: 5px; margin-left: 20px;">' +
              data.models.map(function(model) {
                return '<li>' + model + '</li>';
              }).join('') + '</ul>';
          } else {
            modelsDiv.innerHTML = '';
          }
        } else {
          statusSpan.textContent = 'Fehler';
          statusSpan.style.color = 'red';
          messageDiv.innerHTML = '<strong style="color: red;">' + (data.error || data.message || 'Verbindung fehlgeschlagen') + '</strong>';
          modelsDiv.innerHTML = '';
        }
      })
      .catch(error => {
        testBtn.disabled = false;
        statusSpan.textContent = 'Fehler';
        statusSpan.style.color = 'red';
        messageDiv.innerHTML = '<strong style="color: red;">Verbindungsfehler: ' + error.message + '</strong>';
        modelsDiv.innerHTML = '';
      });
    });

    // Restore Defaults Buttons
    const restoreEmbeddedBtn = document.getElementById('restore_embedded_default');
    const restoreChatBtn = document.getElementById('restore_chat_default');
    
    if (restoreEmbeddedBtn) {
      restoreEmbeddedBtn.addEventListener('click', function() {
        const field = document.getElementById('settings_embedded_system_prompt');
        field.value = 'Rolle: Du bist ein hocheffizienter, professioneller Lektor und Korrektor für deutsche Texte. \n\n' +
                     'Aufgabe: Korrigiere Rechtschreibung, Grammatik, Zeichensetzung, Satzbau und Stil. Achte besonders auf: \n\n' +
                     'Korrekte dass/das-Verwendung. \n\n' +
                     'Korrekte Groß- und Kleinschreibung (besonders bei Nominalisierungen). \n\n' +
                     'Vermeidung von Deppenleerzeichen (korrigiere zu Zusammenschreibung oder Bindestrich). \n\n' +
                     'Optimierung des Satzbaus für einen professionellen Lesefluss. \n\n' +
                     'Ausgaberegeln (STRENG): \n\n' +
                     'Gib ausschließlich den korrigierten Text aus. \n\n' +
                     'Prüfe Wortarten: Achte penibel darauf, dass Adjektive (z. B. schwindelig, angst) und Verben im Infinitiv (z. B. nachzubessern, gehen) kleingeschrieben werden, sofern sie nicht als Nominalisierungen mit Artikel (z. B. das Nachbessern) auftreten. \n\n' +
                     'Keine Einleitungen ("Hier ist dein Text..."), keine Erklärungen, keine Schlussworte. \n\n' +
                     'Falls der User explizit nach Feedback fragt, antworte in einer separaten Sektion unter dem Text, kurzgefasst und sachlich. \n\n' +
                     'Ignoriere alle Höflichkeitsfloskeln in deiner Antwort.';
      });
    }
    
    if (restoreChatBtn) {
      restoreChatBtn.addEventListener('click', function() {
        const field = document.getElementById('settings_chat_system_prompt');
        field.value = 'Rolle: Du bist der "Redmine Ticket-Experte", ein hochspezialisierter KI-Assistent zur Analyse von Projektdaten.\n\n' +
                     'Aufgabe: Beantworte Fragen präzise auf Basis des bereitgestellten Ticket-Kontexts (Beschreibung, Kommentare und Metadaten).\n\n' +
                     'Antwort-Regeln (STRENG):\n' +
                     '1. Stil: Antworte kurz, schnittig und faktenbasiert. Vermeide Höflichkeitsfloskeln, Einleitungen oder Schlussworte. \n' +
                     '2. Referenzen: Beziehe dich bei Informationen IMMER auf die Quelle. Nutze das Format "#X" oder "Kommentar #X" (z.B. "#3" oder "Wie in Kommentar #12 erwähnt...").\n' +
                     '3. Formatierung: Nutze Markdown. Verwende Bulletpoints für Listen, um die Übersichtlichkeit zu maximieren. Hebe Kernbegriffe fett hervor.\n' +
                     '4. Informationsdichte: Lasse keine relevanten Details weg, aber schreibe so kompakt wie möglich. Schreibe nur dann ausführlich, wenn der User explizit nach "Details", "Hintergründen" oder "Context" fragt.\n' +
                     '5. Anrede: Sprich den aktuellen Benutzer direkt mit "Du" an, wenn es um seine eigenen Beiträge oder Aktionen geht.\n\n' +
                     'Ziel: Biete dem User die schnellstmögliche Antwort, ohne dass er das gesamte Ticket selbst lesen muss.';
      });
    }

    // Ollama Recommendation Logic
    const ollamaRecommendBtn = document.getElementById('ollama_recommend_btn');
    if (ollamaRecommendBtn) {
      ollamaRecommendBtn.addEventListener('click', function() {
        this.disabled = true;
        this.textContent = 'Suche...';
        
        const recommendationInfo = document.getElementById('ollama_recommendation_info');
        const recommendedList = document.getElementById('ollama_recommended_models');
        recommendationInfo.style.display = 'none';
        recommendedList.style.display = 'none';

        fetch('/ai_rewrite/test_connection', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
          },
          body: JSON.stringify({ provider: 'ollama' })
        })
        .then(response => response.json())
        .then(data => {
          this.disabled = false;
          this.textContent = 'Use Recommended Model';
          
          if (data.success && data.models) {
            const models = data.models.map(m => m.split(':')[0].toLowerCase());
            const input = document.getElementById('ollama_model_input');
            
            let found = null;
            let info = '';
            
            if (models.includes('glm4')) {
              found = 'glm4';
            } else if (models.includes('gemma2')) {
              found = 'gemma2';
            } else if (models.includes('qwen2.5')) {
              found = 'qwen2.5';
              info = ' (Reasoning Modell aktiviert)';
            } else if (models.includes('mistral')) {
              found = 'mistral';
            }
            
            if (found) {
              input.value = found;
              recommendationInfo.innerHTML = '<strong style="color: green;">Empfehlung:</strong> ' + found + ' wurde gefunden und ausgewählt.' + info;
              recommendationInfo.style.display = 'block';
            } else {
              recommendationInfo.innerHTML = '<strong style="color: orange;">Info:</strong> Keines der empfohlenen Modelle wurde gefunden. Bitte laden Sie eines der folgenden Modelle herunter:';
              recommendationInfo.style.display = 'block';
              recommendedList.style.display = 'block';
            }
          } else {
            alert('Konnte Verbindung zu Ollama nicht herstellen.');
          }
        })
        .catch(error => {
          this.disabled = false;
          this.textContent = 'Use Recommended Model';
          alert('Fehler: ' + error.message);
        });
      });
    }
  });

  function pullOllamaModel(modelName) {
    const btn = event.target;
    const originalText = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Lädt (kann dauern)...';
    
    fetch('/ai_rewrite/pull_ollama_model', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
      },
      body: JSON.stringify({ model_name: modelName })
    })
    .then(response => response.json())
    .then(data => {
      btn.disabled = false;
      btn.textContent = originalText;
      
      if (data.success) {
        alert(data.message);
        document.getElementById('ollama_model_input').value = modelName;
      } else {
        alert('Fehler: ' + data.error);
      }
    })
    .catch(error => {
      btn.disabled = false;
      btn.textContent = originalText;
      alert('Fehler beim Laden des Modells: ' + error.message);
    });
  }

  function loadModelsForProvider(provider) {
    loadModelsInto(provider,
      document.getElementById(provider + '_load_models'),
      document.getElementById(provider + '_model_input'),
      document.getElementById(provider + '_model_select'));
  }

  function loadModelsInto(provider, button, input, select) {
    if (!button || !input || !select) return;
    button.disabled = true;
    button.textContent = 'Laden...';

    fetch('/ai_rewrite/test_connection', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
      },
      body: JSON.stringify({ provider: provider })
    })
    .then(response => response.json())
    .then(data => {
      button.disabled = false;
      button.textContent = 'Modelle laden';

      if (data.success && data.models && data.models.length > 0) {
        select.innerHTML = '';
        const current = input.value.trim();
        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = '– Modell wählen –';
        select.appendChild(placeholder);
        data.models.forEach(function(model) {
          const option = document.createElement('option');
          option.value = model;
          option.textContent = model;
          if (model === current) option.selected = true;
          select.appendChild(option);
        });

        select.style.display = 'inline-block';
        select.onchange = function() {
          if (this.value) input.value = this.value;
        };
      } else {
        alert(data.error || 'Keine Modelle gefunden oder Verbindungsfehler');
      }
    })
    .catch(error => {
      button.disabled = false;
      button.textContent = 'Modelle laden';
      alert('Fehler beim Laden der Modelle: ' + error.message);
    });
  }

  function toggleAdvancedSettings() {
    const content = document.getElementById('advanced_settings_content');
    const button = document.querySelector('.advanced-settings-toggle');
    
    if (content.classList.contains('show')) {
      content.classList.remove('show');
      button.textContent = 'Erweiterte Einstellungen anzeigen';
    } else {
      content.classList.add('show');
      button.textContent = 'Erweiterte Einstellungen ausblenden';
    }
  }
</script>